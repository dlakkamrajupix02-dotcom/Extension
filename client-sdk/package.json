{
  "name": "payload-shield-client",
  "version": "0.1.0",
  "description": "React/TypeScript client SDK for Payload Shield response payload decryption.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {
    "@noble/curves": "^1.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.0.0",
    "tsup": "^8.0.0",
    "vitest": "^1.0.0"
  },

  "keywords": [
    "encryption",
    "react",
    "fastapi",
    "security",
    "webcrypto"
  ],
  "license": "MIT"
}
